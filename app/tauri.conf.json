{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "showfow",
  "version": "0.1.0",
  "identifier": "com.laurens.showfow",
  "build": {
    "beforeDevCommand": "npm run dev:app",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../frontend/main"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "showfow",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
